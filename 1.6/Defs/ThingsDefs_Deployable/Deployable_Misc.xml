<Defs>

    <!-- == Adder-X .50 BMG == -->
    <ThingDef ParentName="BaseBullet">
      <defName>Ammo_127mm</defName>
      <label>.50 BMG</label>
      <graphicData>
        <texPath>Things/Projectile/Bullet_Big</texPath>
        <graphicClass>Graphic_Single</graphicClass>
      </graphicData>
      <projectile>
        <flyOverhead>false</flyOverhead>
        <damageDef>Bullet</damageDef>
        <damageAmountBase>22</damageAmountBase>
        <armorPenetrationBase>0.68</armorPenetrationBase>
        <stoppingPower>1.00</stoppingPower>
        <speed>100</speed> 
      </projectile>
    </ThingDef>

	<!-- ==== Adder-X .50 BMG ==== -->

    <ThingDef ParentName="ResourceBase">
        <defName>OIE_Adder-X_127_mm_Deployable</defName>
        <label>Adder-X .50 BMG (Portable)</label>
        <description>A compact automated turret featuring a reinforced armature with a forward-mounted sensor and a .50 cal. The weapon is rigidly linked to the main sensor unit, allowing precise tracking and continuous fire.

Portable and classic but required a lot of components to construct.</description>
        <graphicData>
            <texPath>Things/Buildings/Deployable/Adder-X/Adder-X_127_mm/Adder-X_12.7_mm_minified</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(3,3)</drawSize>
        </graphicData>
		<recipeMaker>
			<researchPrerequisite>Fabrication</researchPrerequisite>
			<skillRequirements>
				<Crafting>7</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
		</recipeMaker>
        <soundInteract>Metal_Drop</soundInteract>
        <soundDrop>Metal_Drop</soundDrop>
        <stackLimit>5</stackLimit>
        <statBases>
            <WorkToMake>24000</WorkToMake>
            <MaxHitPoints>50</MaxHitPoints>
            <MarketValue>700</MarketValue>
            <Mass>12</Mass>
            <Flammability>0.5</Flammability>
            <CG_DeployableCapacity>5</CG_DeployableCapacity>
        </statBases>
		<costList>
			<Steel>165</Steel>
			<ComponentIndustrial>6</ComponentIndustrial>
		</costList>
        <comps>
            <li Class="CrimsonGridFramework.CompProperties_DeployableItem">
                <buildingDef>OIE_Adder-X_127_mm_ActiveTurret</buildingDef>
                <capacityCost>1</capacityCost>
                <installDuration>300</installDuration>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="BuildingBase">
        <defName>OIE_Adder-X_127_mm_ActiveTurret</defName>
        <label>Adder-X .50 BMG</label>
        <description>A compact automated turret featuring a reinforced armature with a forward-mounted sensor and a .50 cal. The weapon is rigidly linked to the main sensor unit, allowing precise tracking and continuous fire.

Portable and classic but required a lot of components to construct.</description>
        <thingClass>Building_TurretGun</thingClass>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>Things/Buildings/Deployable/Adder-X/Adder-X_base</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(3,3)</drawSize>
            <damageData>
                <rect>(0.2,0.2,0.6,0.6)</rect>
            </damageData>
        </graphicData>
        <uiIconPath>UI/Adder-X_127_mm</uiIconPath>
        <uiIconScale>3</uiIconScale>
        <altitudeLayer>Building</altitudeLayer>
        <stealable>false</stealable>
        <rotatable>false</rotatable>
        <statBases>
            <MaxHitPoints>380</MaxHitPoints>
            <Flammability>0.5</Flammability>
            <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
        </statBases>
        <tickerType>Normal</tickerType>
        <comps>
			<li Class="CompProperties_Explosive">
				<wickTicks>240</wickTicks>
				<explosiveRadius>2.9</explosiveRadius>
				<explosiveDamageType>Bomb</explosiveDamageType>
				<chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
			</li>
            <li Class="CrimsonGridFramework.CompProperties_DeployableBuilding">
                <turnToInactiveWhenDestroyed>True</turnToInactiveWhenDestroyed>
                <inactiveDef>OIE_Adder-X_127_mm_InactiveTurret</inactiveDef>
                <lifespanTicks>60000</lifespanTicks>
            </li>
            <li Class="CompProperties_Forbiddable" />
            <li Class="CompProperties_Flickable" />
        </comps>
        <passability>PassThroughOnly</passability>
        <pathCost>50</pathCost>
        <fillPercent>0.4</fillPercent>
        <hasTooltip>true</hasTooltip>
        <building>
            <combatPower>145</combatPower>
            <ai_combatDangerous>true</ai_combatDangerous>
            <turretGunDef>OIE_Adder-X_127_mm_barrel</turretGunDef>
            <turretBurstCooldownTime>4.8</turretBurstCooldownTime>
            <turretTopDrawSize>3</turretTopDrawSize>
        </building>
        <placeWorkers>
            <li>PlaceWorker_TurretTop</li>
            <li>PlaceWorker_ShowTurretRadius</li>
        </placeWorkers>
    </ThingDef>

